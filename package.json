{
  "name": "cardhaus-promo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts CardhausPromo out/cardhaus-promo.mp4",
    "build:vertical": "remotion render src/index.ts CardhausPromoVertical out/cardhaus-promo-vertical.mp4",
    "build:all": "npm run build && npm run build:vertical",
    "build:gif": "remotion render src/index.ts CardhausPromo out/cardhaus-promo.gif --codec=gif",
    "still": "remotion still src/index.ts CardhausPromo out/poster.png --frame=120",
    "still:vertical": "remotion still src/index.ts CardhausPromoVertical out/poster-vertical.png --frame=120",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
