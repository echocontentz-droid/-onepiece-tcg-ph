# Target store. DEFAULTS TO LOCALHOST. Point this at your own store or a test
# instance only. Do NOT point it at a third-party production site.
TARGET_URL=http://localhost:3000

# A specific product page to watch.
PRODUCT_URL=http://localhost:3000/products/test-booster-box

# How often to poll the product page, in milliseconds.
# Real bots go sub-second; we keep this polite. Lower = more obvious to defenders.
POLL_INTERVAL_MS=3000

# CSS selectors for the target store (adjust to match the real markup).
SELECTOR_STOCK=[data-testid="add-to-cart"]:not([disabled])
SELECTOR_ADD_TO_CART=[data-testid="add-to-cart"]
SELECTOR_CHECKOUT=[data-testid="checkout"]

# Pre-saved checkout details (the "cook" autofill). Test data only.
SHIP_NAME=Test Buyer
SHIP_ADDRESS=123 Test St, Quezon City
SHIP_PHONE=09170000000

# Optional success notifier. Leave blank to log to console only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Run the browser headless (true) or visible (false, good for watching the demo).
HEADLESS=false
